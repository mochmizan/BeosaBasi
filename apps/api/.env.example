# No secrets. Copy to .env locally (never commit .env).
API_PORT=8000
DATABASE_URL=sqlite:///./beosabasi.db

# Anonymous API (no login): cookie + salted IP hash for the daily quota.
BEOSABASI_COOKIE_SECURE=0
BEOSABASI_IP_HASH_SALT=ganti-di-produksi
BEOSABASI_TRUST_PROXY=0
BEOSABASI_CORS_ORIGINS=http://localhost:5173

# Quota / limits (US-07, PRD 2.4)
BEOSABASI_QUOTA_MINUTES=60
BEOSABASI_MAX_ACTIVE_JOBS=2
BEOSABASI_MAX_UPLOAD_BYTES=209715200
BEOSABASI_GLOBAL_CAP_BYTES=8589934592

# Worker API (TK-025). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
BEOSABASI_WORKER_TOKEN=ganti-di-produksi
BEOSABASI_WORKER_MIN_VERSION=0.1.0
BEOSABASI_LEASE_SECONDS=300

# Admin metrics (TK-029). Empty disables /api/admin/metrics.
BEOSABASI_ADMIN_TOKEN=

# Turnstile (TK-003). Empty = dev stub, token still required.
BEOSABASI_TURNSTILE_SECRET=

# Local S3 stand-in (TK-002, printed by dev-up; real R2 values arrive in TK-003)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=beosabasi-dev
S3_KEY_ID=beosabasidevkey01
S3_KEY_SECRET=dev-only-ganti-di-env-lokal
S3_FORCE_PATH_STYLE=1
